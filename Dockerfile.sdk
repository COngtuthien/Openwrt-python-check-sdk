FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    clang \
    flex \
    bison \
    g++ \
    gawk \
    gettext \
    git \
    libncurses-dev \
    libssl-dev \
    python3 \
    rsync \
    unzip \
    zlib1g-dev \
    file \
    wget \
    curl \
    ca-certificates \
    zstd \
    xz-utils \
    time \
    perl \
    patch \
    tar \
    gzip \
    binutils \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /work
